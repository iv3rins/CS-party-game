{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://cs-party-arena.local/schemas/career-content.schema.json",
  "title":"CS Career External Content v1",
  "$defs":{
    "source":{"type":"object","required":["type","reviewStatus"],"properties":{"type":{"enum":["built-in","human-authored","ai-generated"]},"reviewStatus":{"enum":["draft","approved","rejected"]},"generator":{"type":"string"},"promptTemplateVersion":{"type":"string"},"reviewer":{"type":"string"},"contentHash":{"type":"string"}},"additionalProperties":false},
    "coreStats":{"type":"object","required":["ability","connections","integrity","fame","health","internationalAdaptation"],"properties":{"ability":{"type":"number","minimum":0,"maximum":100},"connections":{"type":"number","minimum":0,"maximum":100},"integrity":{"type":"number","minimum":0,"maximum":100},"fame":{"type":"number","minimum":0,"maximum":100},"health":{"type":"number","minimum":0,"maximum":100},"internationalAdaptation":{"type":"number","minimum":0,"maximum":100}},"additionalProperties":false},
    "talentEffects":{"type":"object","properties":{"ability":{"type":"number","minimum":-15,"maximum":15},"connections":{"type":"number","minimum":-15,"maximum":15},"integrity":{"type":"number","minimum":-15,"maximum":15},"fame":{"type":"number","minimum":-15,"maximum":15},"health":{"type":"number","minimum":-15,"maximum":15},"positionFamiliarity":{"type":"number","minimum":-15,"maximum":15},"internationalAdaptation":{"type":"number","minimum":-15,"maximum":15},"highPressureChokingRisk":{"type":"number","minimum":-15,"maximum":15}},"additionalProperties":false},
    "origin":{"type":"object","required":["id","name","place","description","baseStats","variance","initialTeamId","startingAssets","contractHalfSeasons","talentPoolTags","eventWeightTags","earlyOpportunityTags","source"],"properties":{"id":{"enum":["northeast","academy","campus","overseas","southwest","south","central","northwest"]},"name":{"type":"string"},"place":{"type":"string"},"description":{"type":"string"},"baseStats":{"$ref":"#/$defs/coreStats"},"variance":{"type":"object","required":["ability","connections","integrity","fame"],"properties":{"ability":{"type":"number","minimum":0,"maximum":20},"connections":{"type":"number","minimum":0,"maximum":20},"integrity":{"type":"number","minimum":0,"maximum":20},"fame":{"type":"number","minimum":0,"maximum":20}},"additionalProperties":false},"initialTeamId":{"type":"string"},"startingAssets":{"type":"number"},"contractHalfSeasons":{"type":"integer","minimum":1,"maximum":6},"talentPoolTags":{"type":"array","minItems":1,"uniqueItems":true,"items":{"type":"string"}},"eventWeightTags":{"type":"object","additionalProperties":{"type":"integer","minimum":1,"maximum":300}},"earlyOpportunityTags":{"type":"array","minItems":1,"uniqueItems":true,"items":{"type":"string"}},"source":{"$ref":"#/$defs/source"}},"additionalProperties":false},
    "talent":{"type":"object","required":["id","revision","name","description","weight","poolTags","effects","source"],"properties":{"id":{"type":"string","pattern":"^[a-z0-9][a-z0-9-]*$"},"revision":{"type":"integer","minimum":1},"name":{"type":"string"},"description":{"type":"string"},"weight":{"type":"integer","minimum":1},"poolTags":{"type":"array","minItems":1,"uniqueItems":true,"items":{"type":"string"}},"exclusiveGroup":{"type":"string"},"effects":{"$ref":"#/$defs/talentEffects"},"source":{"$ref":"#/$defs/source"}},"additionalProperties":false},
    "retirementQuote":{"type":"object","required":["id","revision","text","tags","weight","source"],"properties":{"id":{"type":"string","pattern":"^[a-z0-9][a-z0-9-]*$"},"revision":{"type":"integer","minimum":1},"text":{"type":"string","minLength":35,"maxLength":140},"tags":{"type":"array","minItems":1,"uniqueItems":true,"items":{"enum":["legend","hall","world","star","veteran","champion","major","top1","top20","clean","famous","long","short","regret","journeyman"]}},"weight":{"type":"integer","minimum":1},"source":{"$ref":"#/$defs/source"}},"additionalProperties":false}
  }
}
