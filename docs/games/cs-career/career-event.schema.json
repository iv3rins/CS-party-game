{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cs-party-arena.local/schemas/career-event.schema.json",
  "title": "CS Career Event Catalog",
  "type": "array",
  "minItems": 1,
  "items": { "$ref": "#/$defs/event" },
  "$defs": {
    "category": {
      "enum": ["赛事内关键局", "赛事内非关键突发", "训练状态", "伤病健康", "队内体系", "教练管理", "合同转会", "角色转职", "舆论媒体", "商业赞助", "合规风险", "家庭生活", "CN生态", "救赎线", "退役转型"]
    },
    "role": { "enum": ["entry", "awper", "igl", "support"] },
    "statChange": {
      "type": "object",
      "properties": {
        "ability": { "type": "number", "minimum": -25, "maximum": 25 },
        "connections": { "type": "number", "minimum": -25, "maximum": 25 },
        "integrity": { "type": "number", "minimum": -25, "maximum": 25 },
        "fame": { "type": "number", "minimum": -25, "maximum": 25 },
        "health": { "type": "number", "minimum": -25, "maximum": 25 },
        "earnings": { "type": "number", "minimum": -100, "maximum": 100 },
        "teamForm": { "type": "number", "minimum": -25, "maximum": 25 },
        "rosterStability": { "type": "number", "minimum": -25, "maximum": 25 },
        "positionFamiliarity": { "type": "number", "minimum": -25, "maximum": 25 },
        "internationalAdaptation": { "type": "number", "minimum": -25, "maximum": 25 },
        "highPressureChokingRisk": { "type": "number", "minimum": -25, "maximum": 25 },
        "employmentStatus": { "enum": ["signed", "free-agent"] },
        "noOfferWindows": { "type": "integer", "minimum": 0, "maximum": 2 },
        "contractTier": { "enum": ["t1", "t2", "t3"] },
        "rolePreparation": { "enum": ["awper-training", "igl-assistant", "none"] },
        "roleChange": { "$ref": "#/$defs/role" },
        "iglArchetype": { "enum": ["brain", "fragging", "awp-caller"] },
        "transfer": { "type": "boolean" },
        "resetVrs": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "resultPatch": {
      "type": "object",
      "properties": {
        "placementDelta": { "type": "integer", "minimum": -1, "maximum": 1 },
        "placement": { "enum": ["首轮出局", "小组赛出局", "八强", "四强", "亚军", "冠军"] },
        "ratingDelta": { "type": "number", "minimum": -0.3, "maximum": 0.3 }
      },
      "additionalProperties": false
    },
    "delayed": {
      "type": "object",
      "required": ["tag", "riskHint", "minSeasons", "maxSeasons", "changes", "revealText"],
      "properties": {
        "tag": { "enum": ["managementTrust", "teamFaction", "trauma", "injuryRisk", "complianceRisk", "rolePrep", "mediaNarrative", "familyDuty"] },
        "riskHint": { "type": "string", "minLength": 4, "maxLength": 40 },
        "minSeasons": { "type": "integer", "minimum": 1, "maximum": 6 },
        "maxSeasons": { "type": "integer", "minimum": 1, "maximum": 6 },
        "changes": { "$ref": "#/$defs/statChange" },
        "revealText": { "type": "string", "minLength": 10, "maxLength": 100 }
      },
      "additionalProperties": false
    },
    "outcome": {
      "type": "object",
      "required": ["id", "label", "probability", "changes"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
        "label": { "type": "string", "minLength": 10, "maxLength": 80 },
        "probability": { "type": "integer", "minimum": 1, "maximum": 99 },
        "changes": { "$ref": "#/$defs/statChange" },
        "resultPatch": { "$ref": "#/$defs/resultPatch" },
        "delayed": { "$ref": "#/$defs/delayed" }
      },
      "additionalProperties": false
    },
    "option": {
      "type": "object",
      "required": ["id", "label", "detail", "changes", "outcomes"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
        "label": { "type": "string", "minLength": 4, "maxLength": 24 },
        "detail": { "type": "string", "minLength": 10, "maxLength": 180 },
        "changes": { "$ref": "#/$defs/statChange" },
        "outcomes": {
          "type": "array",
          "minItems": 2,
          "maxItems": 4,
          "items": { "$ref": "#/$defs/outcome" }
        }
      },
      "additionalProperties": false
    },
    "event": {
      "type": "object",
      "required": ["catalogId", "category", "kind", "title", "briefing", "options"],
      "properties": {
        "catalogId": { "type": "string", "pattern": "^[a-z0-9-]+$" },
        "category": { "$ref": "#/$defs/category" },
        "kind": { "enum": ["emergency", "field", "offseason", "annual"] },
        "timing": { "enum": ["in-season", "post-report"] },
        "title": { "type": "string", "minLength": 4, "maxLength": 40 },
        "briefing": { "type": "string", "minLength": 20, "maxLength": 180 },
        "minAge": { "type": "integer", "minimum": 16, "maximum": 45 },
        "maxAge": { "type": "integer", "minimum": 16, "maximum": 45 },
        "roles": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/role" } },
        "requiresHiddenFlag": { "type": "string" },
        "options": { "type": "array", "minItems": 2, "maxItems": 4, "items": { "$ref": "#/$defs/option" } }
      },
      "additionalProperties": false
    }
  }
}
