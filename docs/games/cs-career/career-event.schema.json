{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cs-party-arena.local/schemas/career-event.schema.json",
  "title": "CS Career AI Event Pack v1",
  "type": "array",
  "minItems": 1,
  "items": { "$ref": "#/$defs/event" },
  "$defs": {
    "value": {
      "oneOf": [
        { "type": "object", "required": ["const"], "properties": { "const": { "type": ["number", "string", "boolean"] } }, "additionalProperties": false },
        { "type": "object", "required": ["var"], "properties": { "var": { "$ref": "#/$defs/variable" } }, "additionalProperties": false }
      ]
    },
    "variable": { "enum": ["career.age","career.season","career.careerYear","player.ability","player.connections","player.integrity","player.fame","player.health","player.positionFamiliarity","player.internationalAdaptation","player.highPressureChokingRisk","team.form","team.rosterStability","team.globalRank","team.regionRank","team.negativeUpsetStreak","team.vrsActive","team.region","team.tier","tournament.tier","tournament.honorClass","tournament.placement","tournament.rating","tournament.isMajor","tournament.isPlayoff"] },
    "condition": {
      "oneOf": [
        { "type":"object", "required":["op","args"], "properties":{"op":{"enum":["all","any"]},"args":{"type":"array","minItems":1,"maxItems":12,"items":{"$ref":"#/$defs/condition"}}}, "additionalProperties":false },
        { "type":"object", "required":["op","arg"], "properties":{"op":{"const":"not"},"arg":{"$ref":"#/$defs/condition"}}, "additionalProperties":false },
        { "type":"object", "required":["op","left","right"], "properties":{"op":{"enum":["eq","ne","lt","lte","gt","gte"]},"left":{"$ref":"#/$defs/value"},"right":{"$ref":"#/$defs/value"}}, "additionalProperties":false },
        { "type":"object", "required":["op","value","set"], "properties":{"op":{"const":"in"},"value":{"$ref":"#/$defs/value"},"set":{"type":"array","minItems":1,"maxItems":20,"items":{"type":["number","string","boolean"]}}}, "additionalProperties":false },
        { "type":"object", "required":["op","value"], "properties":{"op":{"const":"exists"},"value":{"type":"object","required":["var"],"properties":{"var":{"$ref":"#/$defs/variable"}},"additionalProperties":false}}, "additionalProperties":false }
      ]
    },
    "formula": {
      "oneOf": [
        { "type":"number","minimum":0 },
        { "type":"object","required":["const"],"properties":{"const":{"type":"number"}},"additionalProperties":false },
        { "type":"object","required":["var"],"properties":{"var":{"$ref":"#/$defs/variable"}},"additionalProperties":false },
        { "type":"object","required":["op","args"],"properties":{"op":{"enum":["add","mul","min","max"]},"args":{"type":"array","minItems":1,"maxItems":12,"items":{"$ref":"#/$defs/formula"}}},"additionalProperties":false },
        { "type":"object","required":["op","left","right"],"properties":{"op":{"enum":["sub","div"]},"left":{"$ref":"#/$defs/formula"},"right":{"$ref":"#/$defs/formula"}},"additionalProperties":false },
        { "type":"object","required":["op","value"],"properties":{"op":{"enum":["abs","floor","ceil","round"]},"value":{"$ref":"#/$defs/formula"}},"additionalProperties":false },
        { "type":"object","required":["op","value","min","max"],"properties":{"op":{"const":"clamp"},"value":{"$ref":"#/$defs/formula"},"min":{"type":"number"},"max":{"type":"number"}},"additionalProperties":false },
        { "type":"object","required":["op","condition","then","else"],"properties":{"op":{"const":"if"},"condition":{"$ref":"#/$defs/condition"},"then":{"$ref":"#/$defs/formula"},"else":{"$ref":"#/$defs/formula"}},"additionalProperties":false }
      ]
    },
    "statChange": { "type":"object", "properties":{"ability":{"type":"number"},"connections":{"type":"number"},"integrity":{"type":"number"},"fame":{"type":"number"},"health":{"type":"number"},"earnings":{"type":"number"},"assets":{"type":"number"},"teamForm":{"type":"number"},"rosterStability":{"type":"number"},"positionFamiliarity":{"type":"number"},"internationalAdaptation":{"type":"number"},"highPressureChokingRisk":{"type":"number"},"employmentStatus":{"enum":["signed","free-agent","streamer"]},"noOfferWindows":{"type":"integer","minimum":0},"rolePreparation":{"enum":["awper-training","igl-assistant","none"]},"roleChange":{"enum":["entry","awper","igl","support"]},"transfer":{"type":"boolean"},"resetVrs":{"type":"boolean"}}, "additionalProperties":false },
    "delayed": { "type":"object", "required":["tag","riskHint","minSeasons","maxSeasons","changes","revealText"], "properties":{"tag":{"type":"string","pattern":"^[A-Za-z][A-Za-z0-9-]{2,63}$"},"riskHint":{"type":"string","minLength":4,"maxLength":100},"minSeasons":{"type":"integer","minimum":1,"maximum":6},"maxSeasons":{"type":"integer","minimum":1,"maximum":6},"changes":{"$ref":"#/$defs/statChange"},"revealText":{"type":"string","minLength":4,"maxLength":180}}, "additionalProperties":false },
    "outcome": { "type":"object", "required":["id","label","weight","changes"], "properties":{"id":{"type":"string","pattern":"^[a-z0-9][a-z0-9-]*$"},"label":{"type":"string","minLength":2,"maxLength":100},"weight":{"$ref":"#/$defs/formula"},"changes":{"$ref":"#/$defs/statChange"},"delayed":{"$ref":"#/$defs/delayed"}}, "additionalProperties":false },
    "worldlineTransition": { "type":"object", "required":["worldlineId","action"], "properties":{"worldlineId":{"type":"string","pattern":"^[a-z0-9][a-z0-9-]*$"},"action":{"enum":["start","advance","branch","pause","resume","complete","abandon"]},"toStage":{"type":"string","pattern":"^[a-z0-9][a-z0-9-]*$"},"branchId":{"type":"string","pattern":"^[a-z0-9][a-z0-9-]*$"},"note":{"type":"string","maxLength":120}}, "additionalProperties":false },
    "option": { "type":"object", "required":["id","label","changes","outcomes"], "properties":{"id":{"type":"string","pattern":"^[a-z0-9][a-z0-9-]*$"},"label":{"type":"string","minLength":2,"maxLength":40},"detail":{"type":"string","maxLength":180},"changes":{"$ref":"#/$defs/statChange"},"outcomes":{"type":"array","minItems":2,"maxItems":6,"items":{"$ref":"#/$defs/outcome"}},"worldlineTransitions":{"type":"array","maxItems":4,"items":{"$ref":"#/$defs/worldlineTransition"}}}, "additionalProperties":false },
    "source": { "type":"object", "required":["type","reviewStatus"], "properties":{"type":{"enum":["built-in","human-authored","ai-generated"]},"generator":{"type":"string"},"promptTemplateVersion":{"type":"string"},"reviewStatus":{"enum":["draft","approved","rejected"]},"reviewer":{"type":"string"},"contentHash":{"type":"string"}}, "additionalProperties":false },
    "event": { "type":"object", "required":["schemaVersion","catalogId","revision","category","kind","title","briefing","source","eligibility","triggerWeight","options"], "properties":{"schemaVersion":{"const":"1.0"},"catalogId":{"type":"string","pattern":"^[a-z0-9][a-z0-9-]*$"},"revision":{"type":"integer","minimum":1},"category":{"enum":["赛事内关键局","赛事内非关键突发","训练状态","伤病健康","队内体系","教练管理","合同转会","角色转职","舆论媒体","商业赞助","合规风险","家庭生活","CN生态","救赎线","退役转型"]},"kind":{"enum":["emergency","field","offseason","annual"]},"timing":{"enum":["in-season","post-report"]},"title":{"type":"string","minLength":2,"maxLength":60},"briefing":{"type":"string","minLength":4,"maxLength":240},"tags":{"type":"array","uniqueItems":true,"maxItems":12,"items":{"type":"string"}},"source":{"$ref":"#/$defs/source"},"minAge":{"type":"integer","minimum":16,"maximum":60},"maxAge":{"type":"integer","minimum":16,"maximum":60},"roles":{"type":"array","uniqueItems":true,"items":{"enum":["entry","awper","igl","support"]}},"requiresHiddenFlag":{"type":"string"},"eligibility":{"$ref":"#/$defs/condition"},"triggerWeight":{"$ref":"#/$defs/formula"},"cooldownSeasons":{"type":"integer","minimum":0,"maximum":20},"maxOccurrences":{"type":"integer","minimum":1,"maximum":20},"exclusiveGroup":{"type":"string"},"worldline":{"type":"object","required":["worldlineId"],"properties":{"worldlineId":{"type":"string","pattern":"^[a-z0-9][a-z0-9-]*$"},"stages":{"type":"array","uniqueItems":true,"items":{"type":"string"}},"statuses":{"type":"array","uniqueItems":true,"items":{"enum":["active","paused","completed","abandoned"]}}},"additionalProperties":false},"options":{"type":"array","minItems":2,"maxItems":6,"items":{"$ref":"#/$defs/option"}}}, "additionalProperties":false }
  }
}
